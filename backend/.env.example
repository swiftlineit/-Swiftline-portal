RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# All top-up amounts are in paise. 50000000 = 5,00,000 rupees.
RAZORPAY_MIN_TOPUP_MINOR=1000
RAZORPAY_MAX_TOPUP_MINOR=50000000
# Ceiling per business account per IST day, security deposits excluded.
RAZORPAY_MAX_DAILY_TOPUP_MINOR=50000000
# Minutes an unpaid order keeps holding its share of the daily allowance.
RAZORPAY_TOPUP_PENDING_TTL_MINUTES=30
CLIENT_DPD_LABEL_CHARGE_MINOR=0
